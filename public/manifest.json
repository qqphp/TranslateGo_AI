{
  "manifest_version": 3,
  "name": "LLM Web Translator",
  "version": "0.1.0",
  "description": "Translate selected text or replace page text only when you ask, using your own OpenAI-compatible API.",
  "permissions": ["storage", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open LLM Web Translator settings" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }]
}
